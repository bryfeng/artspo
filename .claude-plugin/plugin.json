{
  "name": "artspo",
  "version": "0.8.0",
  "description": "Turn websites you clipped with the Artspo Chrome extension (measured palette, type, shape and motion) into design languages, techniques, tokens, motion specs and pages, and publish or import shareable books.",
  "author": {
    "name": "bryfeng",
    "url": "https://github.com/bryfeng"
  },
  "homepage": "https://artbook.dev",
  "repository": "https://github.com/bryfeng/artspo",
  "license": "MIT",
  "keywords": [
    "design",
    "design-system",
    "design-tokens",
    "motion",
    "inspiration",
    "chrome-extension"
  ],
  "skills": [
    "./extension/skills/artspo"
  ],
  "mcpServers": {
    "artspo": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/artspo_mcp.py"]
    }
  },
  "documentationUrl": "https://github.com/bryfeng/artspo/blob/main/docs/TUTORIAL.md",
  "supportUrl": "https://github.com/bryfeng/artspo/issues",
  "privacyPolicyUrl": "https://github.com/bryfeng/artspo/blob/main/docs/PRIVACY.md"
}
